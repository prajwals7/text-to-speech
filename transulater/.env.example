# =================================================================
# Multilingual AI Voice Assistant - Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Anthropic Claude LLM API Key (Required for AI Reasoning)
# -----------------------------------------------------------------
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------
# 2. Speech-to-Text (STT) Providers
# -----------------------------------------------------------------
# OpenAI Whisper API Key (Used for multilingual STT with 90+ languages)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Deepgram Streaming STT API Key (Optional alternative for ultra-low latency streaming)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# STT Provider Selection: "whisper" | "deepgram" | "browser"
STT_PROVIDER=whisper

# -----------------------------------------------------------------
# 3. Text-to-Speech (TTS) Providers
# -----------------------------------------------------------------
# ElevenLabs API Key (Hyper-realistic voice synthesis)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# TTS Provider Selection: "elevenlabs" | "browser"
TTS_PROVIDER=elevenlabs

# -----------------------------------------------------------------
# 4. Wake-Word Detection
# -----------------------------------------------------------------
# Picovoice Porcupine AccessKey (Optional - local keyword detection)
# Get a free key at: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here
DEFAULT_WAKE_WORD=Hey Assistant

# -----------------------------------------------------------------
# 5. Backend Server Settings
# -----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------
# 6. Default Assistant Settings
# -----------------------------------------------------------------
DEFAULT_SOURCE_LANGUAGE=auto
DEFAULT_TARGET_LANGUAGE=es
DEFAULT_TRANSLATION_MODE=assistant
